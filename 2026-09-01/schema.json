				"location":   { "$ref": "#/definitions/ArrayOfValues" },
				"label":      { "$ref": "#/definitions/ArrayOfLabelValues"}
			},
			"patternProperties": {
				"^[A-Za-z0-9_]+:(.*)$": { "$ref": "#/definitions/ArrayOfValues" }
			},
			"additionalProperties": false
